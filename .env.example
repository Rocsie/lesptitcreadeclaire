NODE_ENV=production

# Port local dédié pour Next.js (Reverse proxy Apache écoutera sur ce port)
PORT=3015

# Connexion MySQL / MariaDB dédiée au projet
DATABASE_URL="mysql://ptites_crea_user:VOTRE_MOT_DE_PASSE@127.0.0.1:3306/ptites_crea_claire"

# URL publique de la boutique
APP_URL="https://lesptitescreadeclaire.com"

# Clé secrète de chiffrement des sessions et tokens
AUTH_SECRET="votre_secret_jwt_et_sessions_minimum_32_caracteres_aleatoires"

# Stripe (Paiements sécurisés CB)
STRIPE_SECRET_KEY="sk_test_votre_cle_secrete_stripe"
STRIPE_WEBHOOK_SECRET="whsec_votre_secret_webhook_stripe"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_votre_cle_publique_stripe"

# SMTP Emails transactionnels
SMTP_HOST="mail.lesptitescreadeclaire.com"
SMTP_PORT=587
SMTP_USER="contact@lesptitescreadeclaire.com"
SMTP_PASSWORD="votre_mot_de_passe_smtp"
SMTP_FROM="Les P'tites Créa de Claire <contact@lesptitescreadeclaire.com>"

# Email de notification de l'artisanat
ADMIN_EMAIL="admin@lesptitescreadeclaire.com"
