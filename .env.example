# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env ne doit jamais être versionné.

NODE_ENV=production

# Port local de Next.js (Apache redirige vers ce port)
PORT=3015

# Adresse publique de la boutique, sans barre finale
APP_URL="https://lesptitescreadeclaire.com"

# Sous-dossier de déploiement. Laisser vide pour un site à la racine du domaine.
# Exemple pour la démo : NEXT_PUBLIC_BASE_PATH="/lpc" (à définir AVANT "npm run build")
NEXT_PUBLIC_BASE_PATH=""

# Dossier des données vivantes (commandes, produits, comptes). Par défaut : ./data
# DATA_DIR="/var/lib/ptites-crea-claire"

# Clé de signature des sessions : 32 caractères aléatoires minimum
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# Compte gestionnaire créé au premier démarrage (8 caractères minimum pour le mot de passe).
# Sans ADMIN_PASSWORD, un mot de passe provisoire est écrit dans data/admin-initial-password.txt.
# Cette adresse reçoit aussi les avis de nouvelle commande et les messages du formulaire de contact.
ADMIN_EMAIL="admin@lesptitescreadeclaire.com"
ADMIN_PASSWORD=""

# Stripe (paiement par carte). Sans ces clés, seul le mode démonstration fonctionne.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# SMTP pour les emails (confirmation de commande, suivi, formulaire de contact).
# Sans SMTP, les emails ne partent pas : ils apparaissent "non envoyés" dans Administration > Paramètres.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Les P'tites Créa de Claire <contact@lesptitescreadeclaire.com>"

# Référencement
# Code de validation Google Search Console : la valeur "content" de la balise google-site-verification.
GOOGLE_SITE_VERIFICATION=""
# Mettre "true" sur une démo ou une préproduction pour interdire l'indexation par les moteurs de recherche.
# À laisser vide sur le vrai site.
SITE_NOINDEX=""

# Sauvegardes ("npm run backup"). Par défaut : dossier ./backups, 14 sauvegardes conservées.
# BACKUP_DIR="/var/backups/ptites-crea-claire"
# BACKUP_KEEP=14
